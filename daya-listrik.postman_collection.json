{
  "info": {
    "name": "Daya Listrik API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:8080" },
    { "key": "recordId", "value": "1" }
  ],
  "item": [
    {
      "name": "List records",
      "request": { "method": "GET", "url": "{{baseUrl}}/api/records" }
    },
    {
      "name": "Get record",
      "request": { "method": "GET", "url": "{{baseUrl}}/api/records/{{recordId}}" }
    },
    {
      "name": "Create record",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": { "mode": "raw", "raw": "{\"device\":\"Air Conditioner\",\"usage\":100,\"duration\":2}" },
        "url": "{{baseUrl}}/api/records"
      }
    },
    {
      "name": "Update record",
      "request": {
        "method": "PUT",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": { "mode": "raw", "raw": "{\"device\":\"Air Conditioner\",\"usage\":120,\"duration\":2}" },
        "url": "{{baseUrl}}/api/records/{{recordId}}"
      }
    },
    {
      "name": "Delete record",
      "request": { "method": "DELETE", "url": "{{baseUrl}}/api/records/{{recordId}}" }
    }
  ]
}
